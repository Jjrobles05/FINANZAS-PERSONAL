    }
    function closeModalCuenta() {
      document.getElementById('modal-cuenta').classList.add('hidden');
      document.getElementById('modal-cuenta').classList.remove('flex');
    }

    function openModalCredito() {
      document.getElementById('credito-fecha').value = today;
      document.getElementById('modal-credito').classList.remove('hidden');
      document.getElementById('modal-credito').classList.add('flex');
    }
    function closeModalCredito() {
      document.getElementById('modal-credito').classList.add('hidden');
      document.getElementById('modal-credito').classList.remove('flex');
    }

    function openModalParametro() {
      document.getElementById('modal-param').classList.remove('hidden');
      document.getElementById('modal-param').classList.add('flex');
    }
    function closeModalParametro() {
      document.getElementById('modal-param').classList.add('hidden');
      document.getElementById('modal-param').classList.remove('flex');
    }

    function updateFormConceptos() {
      const tipo = document.getElementById('form-tipo').value;
      const select = document.getElementById('form-concepto');
      const filtered = conceptosList.filter(c => c.tipo === tipo);

      if (filtered.length === 0) {
        select.innerHTML = `<option value="">Sin conceptos. Crea uno en Parametrización</option>`;
      } else {
        select.innerHTML = filtered.map(c => `<option value="${c.nombre}" data-cat="${c.categoria}">${c.nombre}</option>`).join('');
      }
      autoFillCategoria();
    }

    function autoFillCategoria() {
      const select = document.getElementById('form-concepto');
      const selectedOption = select.options[select.selectedIndex];
      if (selectedOption) {
        document.getElementById('form-categoria').value = selectedOption.getAttribute('data-cat') || 'General';
      }
    }

    function updateFormCuentas() {
      const select = document.getElementById('form-cuenta');
      select.innerHTML = cuentasList.map(c => `<option value="${c.id}">${c.nombre} (${c.tipo.toUpperCase()})</option>`).join('') || `<option value="">Sin cuentas activas</option>`;
    }

    window.fetchAllData = async function() {
      try {
        const resMov = await window.tursoDB.execute("SELECT * FROM movimientos ORDER BY fecha DESC");
        movimientos = resMov.rows.map(r => ({
          id: r.id, tipo: r.tipo, concepto: r.concepto, categoria: r.categoria || 'General',
          monto: parseFloat(r.monto), fecha: r.fecha, cuenta_id: r.cuenta_id, credito_id: r.credito_id
        }));

        const resCon = await window.tursoDB.execute("SELECT * FROM conceptos");
        conceptosList = resCon.rows.map(r => ({ id: r.id, tipo: r.tipo, nombre: r.nombre, categoria: r.categoria }));

        const resCue = await window.tursoDB.execute("SELECT * FROM cuentas");
        cuentasList = resCue.rows.map(r => ({ id: r.id, nombre: r.nombre, tipo: r.tipo, saldo_inicial: parseFloat(r.saldo_inicial) }));

        const resCred = await window.tursoDB.execute("SELECT * FROM creditos");
        creditosList = resCred.rows.map(r => ({
          id: r.id, numero_credito: r.numero_credito, entidad_acreedor: r.entidad_acreedor,
          tipo: r.tipo, monto_prestado: parseFloat(r.monto_prestado), fecha_inicio: r.fecha_inicio
        }));

        renderApp();
      } catch (err) {
        console.error("Error al leer Turso:", err);
      }
    };

    async function handleFormSubmit(e) {
      e.preventDefault();
      const tipo = document.getElementById('form-tipo').value;
      const concepto = document.getElementById('form-concepto').value;
      const categoria = document.getElementById('form-categoria').value || 'General';
      const cuenta_id = document.getElementById('form-cuenta').value;
      const monto = parseFloat(document.getElementById('form-monto').value) || 0;
      const fecha = document.getElementById('form-fecha').value;

      try {
        await window.tursoDB.execute({
          sql: "INSERT INTO movimientos (id, tipo, concepto, categoria, monto, fecha, cuenta_id) VALUES (?, ?, ?, ?, ?, ?, ?)",
          args: [Date.now().toString(), tipo, concepto, categoria, monto, fecha, cuenta_id]
        });
        closeModal();
        window.fetchAllData();
      } catch (err) {
        alert("Error al guardar transacción: " + err.message);
      }
    }

