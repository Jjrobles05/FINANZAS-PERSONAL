<!DOCTYPE html>
<html lang="es" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FinanzasPro - Turso Enterprise</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: { 50: '#ecfdf5', 500: '#10b981', 600: '#059669', 700: '#047857' },
            slate: { 850: '#131e32', 900: '#0f172a', 950: '#080d1a' }
          }
        }
      }
    }
  </script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap');
    body { font-family: 'Plus Jakarta Sans', sans-serif; }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col md:flex-row antialiased">

  <!-- SIDEBAR -->
  <aside class="w-full md:w-64 bg-slate-900 border-r border-slate-800 flex flex-col justify-between min-h-screen p-5">
    <div class="space-y-6">
      <div class="flex items-center space-x-3">
        <div class="bg-gradient-to-tr from-emerald-600 to-teal-400 text-slate-950 p-2.5 rounded-xl shadow-lg shadow-emerald-500/10">
          <i class="fa-solid fa-database text-lg font-black"></i>
        </div>
        <div>
          <h1 class="text-base font-bold text-slate-100 tracking-tight">FinanzasPro</h1>
          <p id="db-status" class="text-[10px] text-amber-400 font-semibold">● Conectando a Turso...</p>
        </div>
      </div>

      <nav class="space-y-1.5">
        <button onclick="switchTab('dashboard')" id="side-dashboard" class="side-btn w-full px-3.5 py-2.5 text-xs font-semibold rounded-xl text-emerald-400 bg-slate-800 flex items-center gap-3">
          <i class="fa-solid fa-grip w-4"></i> Dashboard
        </button>
        <button onclick="switchTab('ingresos')" id="side-ingresos" class="side-btn w-full px-3.5 py-2.5 text-xs font-semibold rounded-xl text-slate-400 hover:bg-slate-800 flex items-center gap-3">
          <i class="fa-solid fa-arrow-trend-up text-emerald-400 w-4"></i> Flujo Ingresos
        </button>
        <button onclick="switchTab('gastos')" id="side-gastos" class="side-btn w-full px-3.5 py-2.5 text-xs font-semibold rounded-xl text-slate-400 hover:bg-slate-800 flex items-center gap-3">
          <i class="fa-solid fa-arrow-trend-down text-rose-400 w-4"></i> Control Gastos / Nómina
        </button>
        <button onclick="switchTab('cuentas')" id="side-cuentas" class="side-btn w-full px-3.5 py-2.5 text-xs font-semibold rounded-xl text-slate-400 hover:bg-slate-800 flex items-center gap-3">
          <i class="fa-solid fa-building-columns text-cyan-400 w-4"></i> Cajas y Bancos
        </button>
        <button onclick="switchTab('deudas')" id="side-deudas" class="side-btn w-full px-3.5 py-2.5 text-xs font-semibold rounded-xl text-slate-400 hover:bg-slate-800 flex items-center gap-3">
          <i class="fa-solid fa-vault text-amber-400 w-4"></i> Módulo Pasivos / Créditos
        </button>
        <button onclick="switchTab('parametros')" id="side-parametros" class="side-btn w-full px-3.5 py-2.5 text-xs font-semibold rounded-xl text-slate-400 hover:bg-slate-800 flex items-center gap-3">
          <i class="fa-solid fa-sliders text-indigo-400 w-4"></i> Parametrización
        </button>
      </nav>
    </div>

    <div class="p-4 border-t border-slate-800 bg-slate-900/50 space-y-1">
      <p class="text-[11px] font-bold text-slate-300">Base de datos Cloud:</p>
      <p class="text-[10px] text-slate-500 truncate">finanzas-perosnales</p>
    </div>
  </aside>

  <!-- CONTENIDO PRINCIPAL -->
  <div class="flex-1 flex flex-col min-h-screen">

    <header class="bg-slate-900 border-b border-slate-800 px-6 py-3.5 flex justify-between items-center flex-wrap gap-3">
      <div class="flex items-center space-x-2 bg-slate-950 px-3 py-1.5 rounded-xl border border-slate-800">
        <i class="fa-regular fa-calendar-check text-emerald-400 text-xs"></i>
        <span class="text-xs text-slate-400 font-medium">Periodo Mes:</span>
        <input type="month" id="monthSelector" onchange="changeMonth(this.value)" class="bg-transparent text-xs font-semibold text-slate-200 focus:outline-none cursor-pointer">
      </div>

      <div class="flex items-center space-x-2">
        <button onclick="openModal('ingreso')" class="bg-emerald-600 hover:bg-emerald-500 text-white px-3.5 py-2 rounded-xl text-xs font-semibold transition flex items-center gap-2">
          <i class="fa-solid fa-plus"></i> Transacción
        </button>
        <button onclick="openModalAbono()" class="bg-amber-600 hover:bg-amber-500 text-white px-3.5 py-2 rounded-xl text-xs font-semibold transition flex items-center gap-2">
          <i class="fa-solid fa-hand-holding-dollar"></i> Abonar Crédito
        </button>
      </div>
    </header>

    <main class="p-6 space-y-6 flex-1">

      <!-- DASHBOARD -->
      <div id="view-dashboard" class="space-y-6">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <div class="bg-slate-900 p-4 rounded-2xl border border-slate-800">
            <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-1">Balance Neto</div>
            <div id="dash-balance" class="text-xl font-extrabold text-slate-100">$0</div>
          </div>
          <div class="bg-slate-900 p-4 rounded-2xl border border-slate-800">
            <div class="text-[11px] font-bold text-emerald-400 uppercase tracking-wider mb-1">Total Ingresos</div>
            <div id="dash-ingresos" class="text-xl font-extrabold text-emerald-400">$0</div>
          </div>
          <div class="bg-slate-900 p-4 rounded-2xl border border-slate-800">
            <div class="text-[11px] font-bold text-rose-400 uppercase tracking-wider mb-1">Total Gastos / Nómina</div>
            <div id="dash-gastos" class="text-xl font-extrabold text-rose-400">$0</div>
          </div>
          <div class="bg-slate-900 p-4 rounded-2xl border border-slate-800">
            <div class="text-[11px] font-bold text-amber-400 uppercase tracking-wider mb-1">Saldo Pasivos Total</div>
            <div id="dash-deudas" class="text-xl font-extrabold text-amber-400">$0</div>
          </div>
        </div>

        <div class="bg-slate-900 p-5 rounded-2xl border border-slate-800">
          <h3 class="text-xs font-bold text-slate-300 uppercase tracking-wider mb-4">Ingresos vs Gastos/Nómina</h3>
          <div class="h-64">
            <canvas id="chartComparison"></canvas>
          </div>
        </div>
      </div>

      <!-- VISTA INGRESOS -->
      <div id="view-ingresos" class="hidden space-y-4">
        <h2 class="text-base font-bold text-slate-100">Ingresos del Mes</h2>
        <div class="bg-slate-900 rounded-2xl border border-slate-800 overflow-hidden">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-850 text-slate-400 font-bold uppercase border-b border-slate-800">
              <tr>
                <th class="p-3.5">Concepto</th>
                <th class="p-3.5">Categoría</th>
                <th class="p-3.5">Cuenta / Banco</th>
                <th class="p-3.5">Fecha</th>
                <th class="p-3.5 text-right">Monto</th>
                <th class="p-3.5 text-center">Acción</th>
              </tr>
            </thead>
            <tbody id="list-ingresos" class="divide-y divide-slate-800 text-slate-300"></tbody>
          </table>
        </div>
      </div>

      <!-- VISTA GASTOS Y NÓMINA -->
      <div id="view-gastos" class="hidden space-y-4">
        <h2 class="text-base font-bold text-slate-100">Gastos y Nómina del Mes</h2>
        <div class="bg-slate-900 rounded-2xl border border-slate-800 overflow-hidden">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-850 text-slate-400 font-bold uppercase border-b border-slate-800">
              <tr>
                <th class="p-3.5">Concepto</th>
                <th class="p-3.5">Módulo</th>
                <th class="p-3.5">Categoría</th>
                <th class="p-3.5">Cuenta / Banco</th>
                <th class="p-3.5">Fecha</th>
                <th class="p-3.5 text-right">Monto</th>
                <th class="p-3.5 text-center">Acción</th>
              </tr>
            </thead>
            <tbody id="list-gastos" class="divide-y divide-slate-800 text-slate-300"></tbody>
          </table>
        </div>
      </div>

      <!-- VISTA MÓDULO BANCOS Y CAJAS -->
      <div id="view-cuentas" class="hidden space-y-6">
        <div class="flex justify-between items-center flex-wrap gap-3">
          <div>
            <h2 class="text-base font-bold text-slate-100">Cuentas Bancarias y Cajas</h2>
            <p class="text-xs text-slate-400">Saldos dinámicos calculados a la fecha seleccionada</p>
          </div>
          <div class="flex items-center space-x-2 bg-slate-900 px-3 py-1.5 rounded-xl border border-slate-800">
            <span class="text-xs text-slate-400 font-medium">Corte a Fecha:</span>
            <input type="date" id="filtroFechaCuenta" onchange="renderApp()" class="bg-slate-950 text-xs text-slate-200 px-3 py-1 rounded-lg border border-slate-800">
          </div>
        </div>
        <div id="grid-cuentas" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4"></div>
      </div>

      <!-- VISTA MÓDULO DE PASIVOS / CRÉDITOS -->
      <div id="view-deudas" class="hidden space-y-6">
        <div class="flex justify-between items-center flex-wrap gap-3">
          <div>
            <h2 class="text-base font-bold text-slate-100">Resumen de Créditos y Pasivos</h2>
            <p class="text-xs text-slate-400">Valor Prestado, Valor Pagado y Saldo al corte</p>
          </div>
          <div class="flex items-center space-x-2 bg-slate-900 px-3 py-1.5 rounded-xl border border-slate-800">
            <span class="text-xs text-slate-400 font-medium">Corte a Fecha:</span>
            <input type="date" id="filtroFechaCredito" onchange="renderApp()" class="bg-slate-950 text-xs text-slate-200 px-3 py-1 rounded-lg border border-slate-800">
          </div>
        </div>
        <div id="grid-creditos" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4"></div>
      </div>

      <!-- VISTA PARAMETRIZACIÓN -->
      <div id="view-parametros" class="hidden space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <button onclick="openModalParametro()" class="bg-slate-900 p-4 rounded-2xl border border-slate-800 hover:border-indigo-500 text-left transition space-y-1">
            <i class="fa-solid fa-list-check text-indigo-400 text-lg"></i>
            <h3 class="font-bold text-xs text-slate-100">Conceptos (Ingresos / Nómina / Gastos)</h3>
            <p class="text-[10px] text-slate-500">Crear y administrar conceptos parametrizados</p>
          </button>
          <button onclick="openModalCuenta()" class="bg-slate-900 p-4 rounded-2xl border border-slate-800 hover:border-cyan-500 text-left transition space-y-1">
            <i class="fa-solid fa-wallet text-cyan-400 text-lg"></i>
            <h3 class="font-bold text-xs text-slate-100">Cuentas Bancarias y Cajas</h3>
            <p class="text-[10px] text-slate-500">Crear bancos o cajas de efectivo</p>
          </button>
          <button onclick="openModalCredito()" class="bg-slate-900 p-4 rounded-2xl border border-slate-800 hover:border-amber-500 text-left transition space-y-1">
            <i class="fa-solid fa-hashtag text-amber-400 text-lg"></i>
            <h3 class="font-bold text-xs text-slate-100">Números de Crédito / Pasivo</h3>
            <p class="text-[10px] text-slate-500">Registrar número de crédito y monto inicial</p>
          </button>
        </div>

        <div class="bg-slate-900 rounded-2xl border border-slate-800 overflow-hidden">
          <div class="p-4 border-b border-slate-800">
            <h3 class="font-bold text-xs text-slate-200">Catálogo de Conceptos Parametrizados</h3>
          </div>
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-850 text-slate-400 font-bold uppercase border-b border-slate-800">
              <tr>
                <th class="p-3.5">Nombre del Concepto</th>
                <th class="p-3.5">Módulo / Tipo</th>
                <th class="p-3.5">Categoría</th>
                <th class="p-3.5 text-center">Acción</th>
              </tr>
            </thead>
            <tbody id="list-conceptos-param" class="divide-y divide-slate-800 text-slate-300"></tbody>
          </table>
        </div>
      </div>

    </main>
  </div>

  <!-- MODAL TRANSACCIÓN MOVIMIENTO -->
  <div id="modal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm hidden items-center justify-center p-4 z-50">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-md w-full p-6 space-y-4 shadow-2xl">
      <div class="flex justify-between items-center border-b border-slate-800 pb-3">
        <h3 class="text-sm font-bold text-slate-100">Registrar Transacción</h3>
        <button onclick="closeModal()" class="text-slate-400 hover:text-white"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <form onsubmit="handleFormSubmit(event)" class="space-y-4">
        <div>
          <label class="block text-[11px] font-semibold text-slate-400 mb-1 uppercase">Módulo</label>
          <select id="form-tipo" onchange="updateFormConceptos()" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-slate-100">
            <option value="ingreso">Ingreso</option>
            <option value="gasto">Gasto</option>
            <option value="nomina">Nómina</option>
          </select>
        </div>
        <div>
          <label class="block text-[11px] font-semibold text-slate-400 mb-1 uppercase">Concepto (Parametrizado)</label>
          <select id="form-concepto" onchange="autoFillCategoria()" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-slate-100"></select>
        </div>
        <div>
          <label class="block text-[11px] font-semibold text-slate-400 mb-1 uppercase">Categoría</label>
          <input type="text" id="form-categoria" readonly class="w-full bg-slate-950/50 border border-slate-800 rounded-xl px-3 py-2 text-xs text-slate-400">
        </div>
        <div>
          <label class="block text-[11px] font-semibold text-slate-400 mb-1 uppercase">Cuenta / Banco / Caja</label>
          <select id="form-cuenta" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-slate-100"></select>
        </div>
        <div>
          <label class="block text-[11px] font-semibold text-slate-400 mb-1 uppercase">Monto ($)</label>
          <input type="number" step="0.01" id="form-monto" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-slate-100">
        </div>
        <div>
          <label class="block text-[11px] font-semibold text-slate-400 mb-1 uppercase">Fecha</label>
          <input type="date" id="form-fecha" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-slate-100">
        </div>
        <div class="flex justify-end space-x-2 pt-3 border-t border-slate-800">
          <button type="button" onclick="closeModal()" class="px-4 py-2 text-xs font-semibold bg-slate-800 text-slate-300 rounded-xl">Cancelar</button>
          <button type="submit" class="px-4 py-2 text-xs font-semibold bg-emerald-600 text-white rounded-xl">Guardar en Turso</button>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL ABONAR A CRÉDITO -->
  <div id="modal-abono" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm hidden items-center justify-center p-4 z-50">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-md w-full p-6 space-y-4 shadow-2xl">
      <div class="flex justify-between items-center border-b border-slate-800 pb-3">
        <h3 class="text-sm font-bold text-slate-100">Registrar Abono a Crédito / Pasivo</h3>
        <button onclick="closeModalAbono()" class="text-slate-400 hover:text-white"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <form onsubmit="handleAbonoSubmit(event)" class="space-y-4">
        <div>
          <label class="block text-[11px] font-semibold text-slate-400 mb-1 uppercase">Seleccionar Crédito</label>
          <select id="abono-credito-id" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-slate-100"></select>
        </div>
        <div>
          <label class="block text-[11px] font-semibold text-slate-400 mb-1 uppercase">Pagar desde Cuenta / Banco</label>
          <select id="abono-cuenta-id" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-slate-100"></select>
        </div>
        <div>
          <label class="block text-[11px] font-semibold text-slate-400 mb-1 uppercase">Monto de Abono ($)</label>
          <input type="number" step="0.01" id="abono-monto" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-slate-100">
        </div>
        <div>
          <label class="block text-[11px] font-semibold text-slate-400 mb-1 uppercase">Fecha del Pago</label>
          <input type="date" id="abono-fecha" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-slate-100">
        </div>
        <div class="flex justify-end space-x-2 pt-3 border-t border-slate-800">
          <button type="button" onclick="closeModalAbono()" class="px-4 py-2 text-xs font-semibold bg-slate-800 text-slate-300 rounded-xl">Cancelar</button>
          <button type="submit" class="px-4 py-2 text-xs font-semibold bg-amber-600 text-white rounded-xl">Registrar Pago</button>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL BANCO / CAJA -->
  <div id="modal-cuenta" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm hidden items-center justify-center p-4 z-50">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-md w-full p-6 space-y-4 shadow-2xl">
      <div class="flex justify-between items-center border-b border-slate-800 pb-3">
        <h3 class="text-sm font-bold text-slate-100">Nueva Cuenta o Caja</h3>
        <button onclick="closeModalCuenta()" class="text-slate-400 hover:text-white"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <form onsubmit="handleCuentaSubmit(event)" class="space-y-4">
        <div>
          <label class="block text-[11px] font-semibold text-slate-400 mb-1 uppercase">Nombre de Cuenta / Banco</label>
          <input type="text" id="cuenta-nombre" required placeholder="Ej: Bancolombia, Caja General, Nequi..." class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-slate-100">
        </div>
        <div>
          <label class="block text-[11px] font-semibold text-slate-400 mb-1 uppercase">Tipo de Entidad</label>
          <select id="cuenta-tipo" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-slate-100">
            <option value="banco">Banco / Cuenta Bancaria</option>
            <option value="caja">Caja / Efectivo</option>
          </select>
        </div>
        <div>
          <label class="block text-[11px] font-semibold text-slate-400 mb-1 uppercase">Saldo Inicial ($)</label>
          <input type="number" step="0.01" id="cuenta-saldo" required placeholder="0.00" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-slate-100">
        </div>
        <div class="flex justify-end space-x-2 pt-3 border-t border-slate-800">
          <button type="button" onclick="closeModalCuenta()" class="px-4 py-2 text-xs font-semibold bg-slate-800 text-slate-300 rounded-xl">Cancelar</button>
          <button type="submit" class="px-4 py-2 text-xs font-semibold bg-cyan-600 text-white rounded-xl">Guardar Cuenta</button>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL NÚMERO DE CRÉDITO / PASIVO -->
  <div id="modal-credito" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm hidden items-center justify-center p-4 z-50">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-md w-full p-6 space-y-4 shadow-2xl">
      <div class="flex justify-between items-center border-b border-slate-800 pb-3">
        <h3 class="text-sm font-bold text-slate-100">Crear Nuevo Crédito / Pasivo</h3>
        <button onclick="closeModalCredito()" class="text-slate-400 hover:text-white"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <form onsubmit="handleCreditoSubmit(event)" class="space-y-4">
        <div>
          <label class="block text-[11px] font-semibold text-slate-400 mb-1 uppercase">Número de Crédito / Pagaré</label>
          <input type="text" id="credito-numero" required placeholder="Ej: CR-2026-001" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-slate-100">
        </div>
        <div>
          <label class="block text-[11px] font-semibold text-slate-400 mb-1 uppercase">Entidad / Acreedor</label>
          <input type="text" id="credito-entidad" required placeholder="Ej: Banco Davivienda, Pedro Pérez..." class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-slate-100">
        </div>
        <div>
          <label class="block text-[11px] font-semibold text-slate-400 mb-1 uppercase">Tipo de Pasivo</label>
          <select id="credito-tipo" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-slate-100">
            <option value="financiera">Financiera (Banco/Tarjeta)</option>
            <option value="personal">Personal (Prestamo/Informal)</option>
          </select>
        </div>
        <div>
          <label class="block text-[11px] font-semibold text-slate-400 mb-1 uppercase">Valor Prestado Total ($)</label>
