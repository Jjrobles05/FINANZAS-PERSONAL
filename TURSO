    async function deleteMovimiento(id) {
      if (confirm('¿Eliminar movimiento?')) {
        await window.tursoDB.execute({ sql: "DELETE FROM movimientos WHERE id = ?", args: [id.toString()] });
        window.fetchAllData();
      }
    }

    async function deleteCredito(id) {
      if (confirm('¿Eliminar este crédito?')) {
        await window.tursoDB.execute({ sql: "DELETE FROM creditos WHERE id = ?", args: [id.toString()] });
        window.fetchAllData();
