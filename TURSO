      const selectCue = document.getElementById('abono-cuenta-id');
      selectCue.innerHTML = cuentasList.map(c => `<option value="${c.id}">${c.nombre} (${c.tipo.toUpperCase()})</option>`).join('') || `<option value="">Sin cuentas activas</option>`;

