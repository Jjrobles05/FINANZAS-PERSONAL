    function formatMoney(val) {
      return '$' + val.toLocaleString('es-CO', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
    }

    function renderApp() {
      const mesMovs = movimientos.filter(m => m.fecha && m.fecha.startsWith(selectedMonth));
      
      const ingresos = mesMovs.filter(m => m.tipo === 'ingreso').reduce((a, b) => a + b.monto, 0);
      const gastos = mesMovs.filter(m => m.tipo === 'gasto' || m.tipo === 'nomina').reduce((a, b) => a + b.monto, 0);

      // Cálculo de Saldo Total Pasivos
      const fechaCredCorte = document.getElementById('filtroFechaCredito').value || today;
      let totalSaldoPasivos = 0;

      creditosList.filter(c => c.fecha_inicio <= fechaCredCorte).forEach(c => {
        const pagado = movimientos.filter(m => m.credito_id === c.id && m.fecha <= fechaCredCorte).reduce((a, b) => a + b.monto, 0);
        totalSaldoPasivos += Math.max(0, c.monto_prestado - pagado);
      });

      document.getElementById('dash-balance').innerText = formatMoney(ingresos - gastos);
      document.getElementById('dash-ingresos').innerText = formatMoney(ingresos);
      document.getElementById('dash-gastos').innerText = formatMoney(gastos);
      document.getElementById('dash-deudas').innerText = formatMoney(totalSaldoPasivos);

      const getNombreCuenta = (id) => {
        const c = cuentasList.find(cu => cu.id === id);
        return c ? c.nombre : 'General';
      };

      // Tabla Ingresos
      document.getElementById('list-ingresos').innerHTML = mesMovs.filter(m => m.tipo === 'ingreso').map(i => `
        <tr class="hover:bg-slate-800/40">
          <td class="p-3.5 font-medium text-slate-100">${i.concepto}</td>
          <td class="p-3.5"><span class="px-2 py-0.5 bg-slate-800 text-[10px] font-semibold rounded-md border border-slate-700">${i.categoria}</span></td>
          <td class="p-3.5 text-cyan-400 font-semibold">${getNombreCuenta(i.cuenta_id)}</td>
          <td class="p-3.5 text-slate-400">${i.fecha}</td>
          <td class="p-3.5 text-right font-bold text-emerald-400">${formatMoney(i.monto)}</td>
          <td class="p-3.5 text-center">
            <button onclick="deleteMovimiento('${i.id}')" class="text-slate-500 hover:text-rose-400"><i class="fa-solid fa-trash-can"></i></button>
          </td>
        </tr>
      `).join('') || `<tr><td colspan="6" class="p-4 text-center text-slate-500">Sin ingresos en este periodo</td></tr>`;

      // Tabla Gastos / Nómina
      document.getElementById('list-gastos').innerHTML = mesMovs.filter(m => m.tipo === 'gasto' || m.tipo === 'nomina').map(g => `
        <tr class="hover:bg-slate-800/40">
          <td class="p-3.5 font-medium text-slate-100">${g.concepto}</td>
          <td class="p-3.5"><span class="px-2 py-0.5 ${g.tipo === 'nomina' ? 'bg-indigo-950 text-indigo-400' : 'bg-rose-950 text-rose-400'} text-[10px] font-bold uppercase rounded-md">${g.tipo}</span></td>
          <td class="p-3.5"><span class="px-2 py-0.5 bg-slate-800 text-[10px] font-semibold rounded-md border border-slate-700">${g.categoria}</span></td>
          <td class="p-3.5 text-cyan-400 font-semibold">${getNombreCuenta(g.cuenta_id)}</td>
          <td class="p-3.5 text-slate-400">${g.fecha}</td>
          <td class="p-3.5 text-right font-bold text-rose-400">${formatMoney(g.monto)}</td>
          <td class="p-3.5 text-center">
            <button onclick="deleteMovimiento('${g.id}')" class="text-slate-500 hover:text-rose-400"><i class="fa-solid fa-trash-can"></i></button>
          </td>
        </tr>
      `).join('') || `<tr><td colspan="7" class="p-4 text-center text-slate-500">Sin gastos ni nómina en este periodo</td></tr>`;

      // Cuentas / Bancos Cards con Filtro de Fecha
      const fechaCueCorte = document.getElementById('filtroFechaCuenta').value || today;
      document.getElementById('grid-cuentas').innerHTML = cuentasList.map(c => {
        const ingCuenta = movimientos.filter(m => m.cuenta_id === c.id && m.tipo === 'ingreso' && m.fecha <= fechaCueCorte).reduce((a, b) => a + b.monto, 0);
        const gasCuenta = movimientos.filter(m => m.cuenta_id === c.id && (m.tipo === 'gasto' || m.tipo === 'nomina') && m.fecha <= fechaCueCorte).reduce((a, b) => a + b.monto, 0);
        const saldoActual = c.saldo_inicial + ingCuenta - gasCuenta;

        return `
          <div class="bg-slate-900 p-5 rounded-2xl border border-slate-800 space-y-3">
            <div class="flex justify-between items-start">
              <div>
                <h3 class="font-bold text-slate-100 text-sm">${c.nombre}</h3>
                <span class="text-[10px] text-cyan-400 font-semibold uppercase">${c.tipo}</span>
              </div>
              <button onclick="deleteCuenta('${c.id}')" class="text-slate-600 hover:text-rose-400 text-xs"><i class="fa-solid fa-trash"></i></button>
            </div>
            <div>
              <p class="text-[10px] text-slate-500">Saldo al ${fechaCueCorte}</p>
              <p class="text-xl font-extrabold ${saldoActual >= 0 ? 'text-emerald-400' : 'text-rose-400'}">${formatMoney(saldoActual)}</p>
            </div>
            <div class="text-[10px] text-slate-400 flex justify-between border-t border-slate-800/80 pt-2">
              <span>Ingresos: <b class="text-emerald-400">${formatMoney(ingCuenta)}</b></span>
              <span>Egresos: <b class="text-rose-400">${formatMoney(gasCuenta)}</b></span>
            </div>
          </div>
        `;
      }).join('') || `<p class="text-xs text-slate-500">No hay bancos o cajas registradas.</p>`;

      // Créditos y Pasivos Cards con Filtro de Fecha
      document.getElementById('grid-creditos').innerHTML = creditosList.filter(c => c.fecha_inicio <= fechaCredCorte).map(c => {
        const valorPagado = movimientos.filter(m => m.credito_id === c.id && m.fecha <= fechaCredCorte).reduce((a, b) => a + b.monto, 0);
        const saldoActual = Math.max(0, c.monto_prestado - valorPagado);
        const pct = Math.min(100, Math.round((valorPagado / c.monto_prestado) * 100));

        return `
          <div class="bg-slate-900 p-5 rounded-2xl border border-slate-800 space-y-3">
            <div class="flex justify-between items-start">
              <div>
                <span class="px-2 py-0.5 bg-amber-950 text-amber-400 text-[10px] font-bold rounded-md uppercase">Crédito #${c.numero_credito}</span>
                <h3 class="font-bold text-slate-100 text-sm mt-1">${c.entidad_acreedor}</h3>
                <span class="text-[10px] text-slate-500">${c.tipo === 'financiera' ? 'Entidad Financiera' : 'Prestamo Personal'}</span>
              </div>
              <button onclick="deleteCredito('${c.id}')" class="text-slate-600 hover:text-rose-400 text-xs"><i class="fa-solid fa-trash"></i></button>
            </div>
            <div class="space-y-1.5 border-t border-slate-800 pt-2">
              <div class="flex justify-between text-xs">
                <span class="text-slate-400">Valor Prestado:</span>
                <span class="font-semibold text-slate-200">${formatMoney(c.monto_prestado)}</span>
              </div>
              <div class="flex justify-between text-xs">
                <span class="text-slate-400">Valor Pagado:</span>
                <span class="font-semibold text-emerald-400">${formatMoney(valorPagado)}</span>
              </div>
              <div class="flex justify-between text-xs">
                <span class="text-slate-400">Saldo al ${fechaCredCorte}:</span>
                <span class="font-extrabold text-amber-400">${formatMoney(saldoActual)}</span>
              </div>
            </div>
            <div class="space-y-1">
              <div class="w-full bg-slate-800 h-1.5 rounded-full overflow-hidden border border-slate-700">
                <div class="bg-emerald-500 h-full" style="width: ${pct}%"></div>
              </div>
              <div class="text-right text-[10px] text-slate-400 font-medium">${pct}% amortizado</div>
            </div>
          </div>
        `;
      }).join('') || `<p class="text-xs text-slate-500">No hay créditos o pasivos registrados a la fecha.</p>`;

      // Parametrización Tabla Conceptos
      document.getElementById('list-conceptos-param').innerHTML = conceptosList.map(c => `
        <tr class="hover:bg-slate-800/40">
          <td class="p-3.5 font-bold text-slate-100">${c.nombre}</td>
          <td class="p-3.5">
            <span class="px-2 py-0.5 ${c.tipo === 'ingreso' ? 'bg-emerald-950 text-emerald-400' : c.tipo === 'nomina' ? 'bg-indigo-950 text-indigo-400' : 'bg-rose-950 text-rose-400'} text-[10px] font-bold uppercase rounded-md">
              ${c.tipo}
            </span>
          </td>
          <td class="p-3.5 text-slate-400">${c.categoria}</td>
          <td class="p-3.5 text-center">
            <button onclick="deleteConcepto('${c.id}')" class="text-slate-500 hover:text-rose-400"><i class="fa-solid fa-trash-can"></i></button>
          </td>
        </tr>
      `).join('') || `<tr><td colspan="4" class="p-4 text-center text-slate-500">No hay conceptos parametrizados</td></tr>`;

      renderChart(ingresos, gastos);
    }

    function renderChart(ing, gas) {
      if (chartComp) chartComp.destroy();
      const ctx = document.getElementById('chartComparison').getContext('2d');
      chartComp = new Chart(ctx, {
        type: 'bar',
        data: {
          labels: ['Ingresos', 'Gastos / Nómina'],
          datasets: [{ data: [ing, gas], backgroundColor: ['#10b981', '#f43f5e'], borderRadius: 8 }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: { y: { ticks: { color: '#64748b' }, grid: { color: '#1e293b' } }, x: { ticks: { color: '#64748b' }, grid: { display: false } } }
        }
      });
    }
  </script>
</body>
</html>
